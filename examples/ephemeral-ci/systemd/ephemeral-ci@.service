[Unit]
Description=Ephemeral CI %i
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/ephemeral-ci/venv/bin/python -I -B /opt/ephemeral-ci/controller.py %i
StateDirectory=ephemeral-ci
StateDirectoryMode=0700
UMask=0077
TimeoutStartSec=120
KillMode=control-group
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ReadWritePaths=/var/lib/ephemeral-ci
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=512M
TasksMax=32
LimitCORE=0
