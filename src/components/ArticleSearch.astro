<search class="article-search" id="search" aria-label="Поиск по статьям">
	<label class="article-search-label" for="article-search-input">Поиск по статьям</label>
	<div class="article-search-field">
		<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="6.5" stroke="currentColor" stroke-width="1.7" /><path d="m16 16 4.5 4.5" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg>
		<input id="article-search-input" type="search" placeholder="Поиск по статьям" autocomplete="off" spellcheck="false" maxlength="160" aria-controls="articles-list" />
		<button type="button" aria-label="Очистить поиск" data-search-clear hidden><svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="m6 6 12 12M18 6 6 18" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" /></svg></button>
	</div>
	<p class="article-search-status" role="status" data-search-status hidden></p>
	<noscript>Для поиска нужен JavaScript. Все материалы доступны в списке ниже.</noscript>
</search>

<script>
	import { searchArticles, type SearchArticle } from '../lib/article-search';
	const input = document.querySelector<HTMLInputElement>('#article-search-input');
	const clear = document.querySelector<HTMLButtonElement>('[data-search-clear]');
	const status = document.querySelector<HTMLElement>('[data-search-status]');
	const list = document.querySelector<HTMLElement>('#articles-list');
	const cards = Array.from(list?.querySelectorAll<HTMLAnchorElement>('.articles-item') ?? []);
	const articles: SearchArticle[] = cards.map((card) => ({
		url: card.pathname,
		title: card.querySelector('h2')?.textContent ?? '',
		description: card.querySelector('p')?.textContent ?? '',
	}));
	let contentPromise: Promise<boolean> | undefined;
	let request = 0;

	function loadContent() {
		if (!contentPromise) {
			contentPromise = Promise.allSettled(articles.map(async (article) => {
				if (article.body !== undefined) return;
				const response = await fetch(article.url, { credentials: 'omit', signal: AbortSignal.timeout(8000) });
				if (!response.ok) throw new Error('Article unavailable');
				const document = new DOMParser().parseFromString(await response.text(), 'text/html');
				const body = document.querySelector('[data-search-body]');
				if (!body) throw new Error('Article content missing');
				body.querySelectorAll('[data-search-ignore], script, style, nav, noscript').forEach((element) => element.remove());
				article.body = body.textContent?.replace(/\s+/g, ' ').trim() ?? '';
			})).then((results) => {
				const complete = results.every((result) => result.status === 'fulfilled');
				if (!complete) contentPromise = undefined;
				return complete;
			});
		}
		return contentPromise;
	}

	function render(query: string) {
		const matches = new Set(searchArticles(articles, query));
		cards.forEach((card) => { card.hidden = !matches.has(card.pathname); });
		return matches.size;
	}

	async function updateSearch() {
		if (!input || !clear || !status || !list) return;
		const current = ++request;
		const query = input.value.trim();
		clear.hidden = input.value === '';
		status.hidden = query === '';
		render(query);
		if (!query) { list.removeAttribute('aria-busy'); return; }
		status.textContent = 'Ищем…';
		list.setAttribute('aria-busy', 'true');
		const complete = await loadContent();
		if (current !== request) return;
		const count = render(query);
		list.removeAttribute('aria-busy');
		status.textContent = count ? `Найдено статей: ${count}` : 'Ничего не найдено. Попробуйте другое слово.';
		if (!complete) status.textContent += ' Полный текст некоторых статей не загрузился; поиск по названиям и описаниям работает.';
	}
	input?.addEventListener('input', () => { void updateSearch(); });
	input?.addEventListener('search', () => { void updateSearch(); });
	clear?.addEventListener('click', () => {
		if (!input) return;
		input.value = '';
		input.focus();
		void updateSearch();
	});
	void updateSearch();
</script>

<style>
	.article-search { max-width: 68rem; margin: 2.5rem auto 0; scroll-margin-top: 6rem; }
	.article-search-label { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
	.article-search-field { position: relative; display: flex; align-items: center; }
	.article-search-field > svg { position: absolute; left: 1.1rem; color: var(--muted); pointer-events: none; }
	input { width: 100%; height: 56px; padding: 0 3.5rem 0 3rem; border: 1px solid #b8bcc4; border-radius: 8px; background: #fff; color: var(--ink); font: inherit; font-size: 1rem; appearance: none; transition: border-color .1s; }
	input::placeholder { color: var(--muted); opacity: 1; }
	input:focus-visible { border-color: var(--blue); outline: 2px solid var(--blue); outline-offset: 2px; }
	input::-webkit-search-cancel-button { appearance: none; }
	button { position: absolute; right: 6px; display: grid; place-items: center; width: 44px; height: 44px; padding: 0; border: 0; border-radius: 6px; background: transparent; color: var(--muted); cursor: pointer; transition: color .1s, background-color .1s; }
	button:hover { background: var(--soft); color: var(--ink); }
	button:focus-visible { outline: 2px solid var(--blue); outline-offset: 2px; }
	.article-search-status, noscript { margin: .85rem 0 0; color: var(--muted); font-size: .85rem; line-height: 1.6; }
	[hidden] { display: none; }
	@media print { .article-search { display: none; } }
</style>
