---
import {type Locale} from '../data/site';
import {productStory} from '../data/productStory';
import ScopePanel from './ScopePanel.astro';

interface Props {locale: Locale; staticView?: boolean;}
const {locale, staticView = false} = Astro.props;
const ru = locale === 'ru';
const {brief, points} = productStory[locale];
const offsets = [['-5cqw', '-10cqw'], ['53cqw', '-14cqw'], ['-7cqw', '8cqw'], ['48cqw', '-3cqw']];
// Target geometry is in percentages of the same paper: two above, two below the wordmark.
const cards = [{x: 2, y: 10, w: 44, h: 32}, {x: 54, y: 10, w: 44, h: 32}, {x: 2, y: 66, w: 44, h: 32}, {x: 54, y: 66, w: 44, h: 32}];
// Make room for the derived action without crossing the central brand or the other column.
const preparedTops = [-4, -4, 66, 66];
// Physical SVG units: equal dx/dy makes the PCB corners exactly 45 degrees.
const traces = ['M58.8 42V44L68.8 54H70', 'M81.2 42V44L71.2 54H70', 'M58.8 66V64L68.8 54H70', 'M81.2 66V64L71.2 54H70'];
// Fan into two short queues in the row gap, then dock outside-in above the cards.
const letterOrder = [0, 2, 4, 6, 7, 5, 3, 1];
const letterSlots = [46, 51, 56, 61, 61, 56, 51, 46];
const letterLanes = [46.1, 46.1, 46.1, 47.6, 50.25, 50.6, 50.6, 50.6];
---

<!-- Each answer, spec section and planned action keeps the same paper fragment.
     The four fragments join into the plan; no second sheet replaces them. -->
<product-morph class:list={['product-model', {'product-model_static': staticView}]} data-story-motion aria-hidden="true">
	{staticView && <div class="product-static-screen"><ScopePanel kind="frontend" locale={locale} /></div>}
	{!staticView && <>
		<svg class="product-brief" data-story-motion viewBox="0 0 100 71.4286" text-anchor="middle" focusable="false">
			<text class="brief-label" x="50" y="15">{brief.label}</text>
			{brief.lines.map((line, i) => <text class="brief-line" x="50" y={27 + i * 9}>{line}</text>)}
		</svg>
		<canvas class="product-particles"></canvas>
		<div class="product-person" data-story-motion>
			<svg class="product-face" data-story-motion viewBox="0 0 120 120" fill="none" focusable="false">
				<circle class="product-head" cx="60" cy="61" r="39" />
				<g class="product-eyes" data-story-motion><circle cx="47" cy="55" r="3.5" /><circle cx="73" cy="55" r="3.5" /></g>
				<path class="product-brow" data-story-motion d="M39 43Q46 37 53 42" />
				<path class="product-mouth" data-story-motion d="M46 74Q60 62 74 74" />
				<path class="product-hand" data-story-motion d="M76 101V88L66 84Q62 82 65 78Q67 76 71 78L79 80V71Q79 67 83 68L91 82Q94 87 92 94L89 101" />
				<g class="product-thought" data-story-motion><circle cx="99" cy="30" r="15" /><path d="M95 26C95 20 104 20 104 26C104 30 99 29 99 33M99 38v.1" /></g>
				<path class="product-insight" data-story-motion d="M102 9V17M114 17L108 23M119 31H111" />
			</svg>
		</div>
		<div class="product-spec" data-story-motion>
			{points.map((point, i) => <div class:list={['product-fragment', {'product-fragment_first': i === 0, 'product-fragment_last': i === points.length - 1}]} data-story-motion style={`--i: ${i}; --split-left: ${cards[i].x}%; --split-top: ${cards[i].y}%; --split-width: ${cards[i].w}%; --split-height: ${cards[i].h}%; --prepared-top: ${preparedTops[i]}%; --ordered-top: ${10 + i * 31}%; --plan-top: ${16 + i * 22}%; --compact-copy-width: ${cards[i].w * .847826 - 3}cqw`}>
				<div class="fragment-paper" data-story-motion>
					{i === 0 && <div class="product-spec-heading" data-story-motion><strong>{ru ? 'Ответы на вопросы' : 'Questions answered'}</strong><span>{ru ? 'Кабинет заказчика' : 'Client portal'}</span></div>}
				</div>
				<div class="product-note" data-point={point.key} data-story-motion style={`--note-x: ${offsets[i][0]}; --note-y: ${offsets[i][1]}`}>
					<div class="note-heading-row">
						<i class="note-anchor" data-story-motion><span class="task-number" data-story-motion>{i + 1}</span></i>
						<div class="note-heading" data-story-motion><div class="question-reel" data-story-motion><span class="story-seed">{point.seed}</span><span class="story-question">{point.question}</span></div></div>
						<strong class="spec-title" data-story-motion>{point.spec.title}</strong>
					</div>
					<div class="discovery-answer" data-story-motion><div class="story-answer" data-story-motion>{point.requirement}</div></div>
					<div class="spec-copy" data-story-motion>
						<strong>{point.spec.summary}</strong>
						<small class="spec-artifact">{point.spec.artifact}</small>
					</div>
					<div class="product-task" data-story-motion>{point.task}</div>
				</div>
			</div>)}
			<svg class="spec-circuits" data-story-motion viewBox="0 0 140 100" fill="none" focusable="false">
				<defs>{traces.map((d, i) => <mask id={`spec-trace-${locale}-${i}`} maskUnits="userSpaceOnUse" x="0" y="0" width="140" height="100"><path class="spec-trace-reveal" data-story-motion d={d} pathLength="1" /></mask>)}</defs>
				{traces.map((d, i) => <path class="spec-trace" d={d} mask={`url(#spec-trace-${locale}-${i})`} />)}
			</svg>
			<div class="product-spec-brand" data-story-motion aria-label="OpenSpec">
				{letterOrder.map((order, i) => <svg class="spec-letter" data-story-motion viewBox={`${i * 80} 0 80 80`} focusable="false" style={`--letter-start: ${36 + i * 3.5}%; --letter-end: ${39 + i * 2.75}%; --letter-lane: ${letterLanes[i]}%; --letter-slot: ${letterSlots[i]}%; --letter-order: ${order}`}>
					<image href="/brands/openspec.svg" width="640" height="80" />
				</svg>)}
			</div>
			<div class="product-plan-heading" data-story-motion>{ru ? 'План работы' : 'Implementation plan'}</div>
		</div>
	</>}
	<div class="product-layer product-logic" data-story-motion>
		<svg viewBox="0 0 24 24" fill="none"><path d="M5 5H12V12H19M5 19H12V12" /><circle cx="4" cy="5" r="2" /><circle cx="4" cy="19" r="2" /><circle cx="20" cy="12" r="2" /></svg>
		<span>{ru ? 'Логика' : 'Logic'}</span><small>{ru ? 'Правила и сценарии' : 'Rules and workflows'}</small>
	</div>
	<div class="product-layer product-data" data-story-motion>
		<svg viewBox="0 0 24 24" fill="none"><ellipse cx="12" cy="5" rx="8" ry="3" /><path d="M4 5V19C4 23 20 23 20 19V5M4 12C4 16 20 16 20 12" /></svg>
		<span>{ru ? 'Данные' : 'Data'}</span><small>{ru ? 'Состояние и история' : 'State and history'}</small>
	</div>
	<svg class="product-route" viewBox="0 0 100 100" fill="none" preserveAspectRatio="none" focusable="false" data-story-motion>
		<path class="product-route-line" d="M90 42H96V106H90M10 106H4V42H10" vector-effect="non-scaling-stroke" />
		<path class="product-flow" pathLength="1" d="M90 42H96V106H10H4V42H10" data-story-motion />
	</svg>
</product-morph>

<script>
	import '../lib/productMorph';
</script>
