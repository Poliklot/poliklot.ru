---
import '@gravity-ui/uikit/styles/styles.css';
import '../styles/global.css';
import { getRootClassName } from '@gravity-ui/uikit/server';
import { HeaderActions } from '../components/GravityUI';
import type { Locale } from '../data/site';
import { copy } from '../data/site';

interface Props {
	title: string;
	description: string;
	locale: Locale;
	path?: string;
	alternatePath?: string;
}

const { title, description, locale, path = '/', alternatePath } = Astro.props;
const t = copy[locale];
const home = locale === 'ru' ? '/' : '/en/';
const canonical = new URL(path, Astro.site ?? 'https://poliklot.ru');
const alternateLocale = locale === 'ru' ? 'en' : 'ru';
const alternate = alternatePath ? new URL(alternatePath, Astro.site ?? 'https://poliklot.ru') : undefined;
const ogImage = new URL('/og-poliklot.png', Astro.site ?? 'https://poliklot.ru');
const ogImageAlt = locale === 'ru'
	? 'Игорь / Poliklot — сложные цифровые продукты целиком'
	: 'Igor / Poliklot — complex digital products end to end';
const rootClassName = getRootClassName({ theme: 'light' });
const languageHref = alternatePath ?? (locale === 'ru' ? '/en/' : '/');
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#ffffff" />
		<meta name="description" content={description} />
		<meta name="color-scheme" content="light" />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:secure_url" content={ogImage} />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<link rel="canonical" href={canonical} />
		{alternate && <link rel="alternate" hreflang={alternateLocale} href={alternate} />}
		<link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site ?? 'https://poliklot.ru')} />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#c62026" />
		<link rel="manifest" href="/site.webmanifest" />
		<title>{title}</title>
	</head>
	<body class={rootClassName}>
		<a class="skip-link" href="#content">{locale === 'ru' ? 'К содержанию' : 'Skip to content'}</a>
		<header class="document-bar">
			<div class="page-width document-bar-inner">
				<a class="brand-mark" href={home} aria-label={locale === 'ru' ? 'Главная страница' : 'Home'}><img src="/logo-eagle.png" width="48" height="48" alt="" /></a>
				<nav class="site-nav" aria-label={locale === 'ru' ? 'Навигация' : 'Navigation'}>
					<a href={`${home}#scope`}>{t.nav.scope}</a>
					<a href={`${home}#stack`}>{t.nav.stack}</a>
					<a href={`${home}#experience`}>{t.nav.experience}</a>
				</nav>
				<HeaderActions language={t.alternateLabel} languageHref={languageHref} resumeLabel={t.headerResume} />
			</div>
		</header>
		<main id="content"><slot /></main>
		<footer class="site-footer">
			<div class="page-width footer-inner"><p>© {new Date().getFullYear()} Igor / Poliklot</p><p>{t.footer}</p></div>
		</footer>
	</body>
</html>
