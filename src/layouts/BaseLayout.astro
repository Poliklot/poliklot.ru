---
import '@gravity-ui/uikit/styles/styles.css';
import '../styles/global.css';
import { getRootClassName } from '@gravity-ui/uikit/server';
import { HeaderActions } from '../components/GravityUI';
import type { Locale } from '../data/site';
import { copy, HH_URL } from '../data/site';

interface Props {
	title: string;
	description: string;
	locale: Locale;
	path?: string;
	alternatePath?: string;
}

const { title, description, locale, path = '/', alternatePath } = Astro.props;
const t = copy[locale];
const home = locale === 'ru' ? '/' : '/en/';
const canonical = new URL(path, Astro.site ?? 'https://poliklot.ru');
const alternateLocale = locale === 'ru' ? 'en' : 'ru';
const alternate = alternatePath ? new URL(alternatePath, Astro.site ?? 'https://poliklot.ru') : undefined;
const siteUrl = new URL('/', Astro.site ?? 'https://poliklot.ru');
const ogImage = new URL('/og-poliklot-2026-09.jpg', siteUrl);
const personId = new URL('/#igor-poliklot', siteUrl);
const ogImageAlt = locale === 'ru'
	? 'Игорь / Poliklot — сложные цифровые продукты целиком'
	: 'Igor / Poliklot — complex digital products end to end';
const rootClassName = getRootClassName({ theme: 'light' });
const languageHref = alternatePath ?? (locale === 'ru' ? '/en/' : '/');
const structuredData = [
	{
		'@context': 'https://schema.org',
		'@type': 'WebSite',
		'@id': new URL('/#website', siteUrl).href,
		url: siteUrl.href,
		name: 'Poliklot',
		alternateName: 'Игорь / Poliklot',
		inLanguage: ['ru', 'en'],
	},
	{
		'@context': 'https://schema.org',
		'@type': 'ProfilePage',
		'@id': `${canonical.href}#profile-page`,
		url: canonical.href,
		name: title,
		description,
		inLanguage: locale,
		dateModified: '2026-09-07',
		isPartOf: {'@id': new URL('/#website', siteUrl).href},
		mainEntity: {'@id': personId.href},
	},
	{
		'@context': 'https://schema.org',
		'@type': 'Person',
		'@id': personId.href,
		name: locale === 'ru' ? 'Игорь / Poliklot' : 'Igor / Poliklot',
		alternateName: 'Poliklot',
		url: siteUrl.href,
		image: new URL('/logo-eagle.png', siteUrl).href,
		jobTitle: t.role,
		description,
		knowsAbout: ['Full-stack development', 'Frontend architecture', 'Product engineering', 'DevSecOps', 'AI agents', 'LLM integrations', 'Mobile development', 'Technical leadership'],
		sameAs: ['https://github.com/Poliklot', HH_URL],
		alumniOf: {
			'@type': 'CollegeOrUniversity',
			name: locale === 'ru' ? 'Кубанский государственный технологический университет' : 'Kuban State Technological University',
		},
	},
];
---

<!doctype html>
<html lang={locale} prefix="og: https://ogp.me/ns#">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#ffffff" />
		<meta name="description" content={description} />
		<meta name="author" content={locale === 'ru' ? 'Игорь / Poliklot' : 'Igor / Poliklot'} />
		<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
		<meta name="color-scheme" content="light" />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Poliklot" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:url" content={ogImage} />
		<meta property="og:image:secure_url" content={ogImage} />
		<meta property="og:image:type" content="image/jpeg" />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:alt" content={ogImageAlt} />
		<meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />
		<meta property="og:locale:alternate" content={locale === 'ru' ? 'en_US' : 'ru_RU'} />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:url" content={canonical} />
		<meta name="twitter:image" content={ogImage} />
		<meta name="twitter:image:alt" content={ogImageAlt} />
		<link rel="canonical" href={canonical} />
		<link rel="alternate" hreflang={locale} href={canonical} />
		{alternate && <link rel="alternate" hreflang={alternateLocale} href={alternate} />}
		<link rel="alternate" hreflang="x-default" href={siteUrl} />
		<link rel="image_src" href={ogImage} />
		<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
		<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
		<link rel="shortcut icon" href="/favicon.ico" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<link rel="mask-icon" href="/safari-pinned-tab.svg" color="#c62026" />
		<link rel="manifest" href="/site.webmanifest" />
		{structuredData.map((entry) => <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)}></script>)}
		<title>{title}</title>
	</head>
	<body class={rootClassName}>
		<a class="skip-link" href="#content">{locale === 'ru' ? 'К содержанию' : 'Skip to content'}</a>
		<header class="document-bar">
			<div class="page-width document-bar-inner">
				<a class="brand-mark" href={home} aria-label={locale === 'ru' ? 'Главная страница' : 'Home'}><img src="/logo-eagle.png" width="48" height="48" alt="" /></a>
				<nav class="site-nav" aria-label={locale === 'ru' ? 'Навигация' : 'Navigation'}>
					<a href={`${home}#scope`}>{t.nav.scope}</a>
					<a href={`${home}#stack`}>{t.nav.stack}</a>
					<a href={`${home}#experience`}>{t.nav.experience}</a>
				</nav>
				<HeaderActions language={t.alternateLabel} languageHref={languageHref} resumeLabel={t.headerResume} />
			</div>
		</header>
		<main id="content"><slot /></main>
		<footer class="site-footer">
			<div class="page-width footer-inner"><p>© {new Date().getFullYear()} Igor / Poliklot</p><p>{t.footer}</p></div>
		</footer>
	</body>
</html>
