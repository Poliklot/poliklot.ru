	</article>

	<script is:inline>
		const tabs = Array.from(document.querySelectorAll('[data-guide-tab]'));
		const panels = Array.from(document.querySelectorAll('[data-guide-panel]'));

		function activateTab(name, moveFocus = false) {
			for (const tab of tabs) {
				const active = tab.dataset.guideTab === name;
				tab.setAttribute('aria-selected', String(active));
				tab.tabIndex = active ? 0 : -1;
				if (active && moveFocus) tab.focus();
			}

			for (const panel of panels) {
				panel.hidden = panel.dataset.guidePanel !== name;
			}
		}

		for (const tab of tabs) {
			tab.addEventListener('click', () => {
				const name = tab.dataset.guideTab;
				activateTab(name);
				history.replaceState(null, '', `#${name}`);
				const panel = panels.find((item) => item.dataset.guidePanel === name);
				requestAnimationFrame(() => panel?.scrollIntoView({ block: 'start' }));
			});

			tab.addEventListener('keydown', (event) => {
				const index = tabs.indexOf(tab);
				let nextIndex = null;
				if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
				if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
				if (event.key === 'Home') nextIndex = 0;
				if (event.key === 'End') nextIndex = tabs.length - 1;
				if (nextIndex !== null) {
					event.preventDefault();
					const name = tabs[nextIndex].dataset.guideTab;
					activateTab(name, true);
					history.replaceState(null, '', `#${name}`);
				}
			});
		}

		const hash = window.location.hash.slice(1);
		const directTab = tabs.find((tab) => tab.dataset.guideTab === hash)?.dataset.guideTab;
		const anchor = hash ? document.getElementById(hash) : null;
		const anchorPanel = anchor?.closest('[data-guide-panel]')?.dataset.guidePanel;
		activateTab(directTab || anchorPanel || 'general');
		if (anchorPanel && anchor) requestAnimationFrame(() => anchor.scrollIntoView({ block: 'start' }));

		for (const button of document.querySelectorAll('[data-share-button]')) {
			button.addEventListener('click', async () => {
				const label = button.querySelector('[data-share-label]');
				try {
					await navigator.clipboard.writeText(window.location.href);
					if (label) label.textContent = 'Ссылка скопирована';
				} catch {
					window.prompt('Скопируйте ссылку', window.location.href);
				}
				window.setTimeout(() => { if (label) label.textContent = 'Скопировать ссылку'; }, 2200);
			});
		}
	</script>
</BaseLayout>
